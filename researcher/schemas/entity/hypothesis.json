{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/entity/hypothesis.json",
  "title": "Hypothesis: a mechanism claim with a prediction and a lever (System Design 3.1 #5).",
  "type": "object",
  "required": [
    "id",
    "statement",
    "prediction",
    "topics",
    "lever",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^H-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "prediction": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": "string"
      }
    },
    "lever": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "proposed",
        "under-test",
        "supported",
        "falsified",
        "abandoned"
      ]
    },
    "state_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
