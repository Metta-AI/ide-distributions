{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/entity/evidence.json",
  "title": "Evidence index entry: replays, XP results, logs, artifacts, league snapshots, game-source citations (System Design 3.1 #1). Immutable.",
  "type": "object",
  "required": [
    "id",
    "sha256",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EV-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "replay",
        "xp-result",
        "log",
        "artifact",
        "leaderboard-snapshot",
        "game-source"
      ]
    },
    "source_ids": {
      "type": "object"
    },
    "game_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fetched_at": {
      "type": "string"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
