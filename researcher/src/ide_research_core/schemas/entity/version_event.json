{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/entity/version_event.json",
  "title": "Version event: an upload or submission of a version. Immutable; lives at versions/<V-id>/events/<VE-id>.json.",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "recorded_at",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VE-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "string",
      "pattern": "^V-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "enum": [
        "uploaded",
        "submitted",
        "sources_registered"
      ]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
