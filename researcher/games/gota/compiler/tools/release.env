# Vendored from personal_labs_paintbot_pw@6b0bffa5085ffc4bf94ecaa8baee463e55599c84: paintbot_pw_lab/tools/release.env
# The paintbot-pw release the lab tools build and run against. Single source of truth:
# build_tools.sh and build_native.sh `source` this file, and every Python tool reads it
# through tools/pw_release.py. Print it with:
#   uv run python paintbot_pw_lab/tools/pw_release.py
# Update it with `uv run python paintbot_pw_lab/tools/deployed_ref.py --write` (then rebuild),
# never by editing tag literals in the tools.
#
# Two pins, on purpose:
#   PW_RELEASE_TAG / PW_RELEASE_SHA  the build the tools use. Follows the league: a newer build
#                                    replays older rules versions hash-exactly, so tracking the
#                                    league's tag is enough for analysis and local play.
#   PW_DOCS_SHA                      the commit the lab's mechanics/policy docs were verified at.
#                                    Their `file.nim:NN` citations are exact at THIS commit, so it
#                                    only moves after someone re-verifies the docs. deployed_ref.py
#                                    prints the rule-file diffstat between it and the league's build.
PW_RELEASE_TAG=coworld-v0.3.124
PW_RELEASE_SHA=7a29ed7a
PW_DOCS_SHA=118e1619
