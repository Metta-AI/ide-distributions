          if available = 1 and gap < chosenDistance then
            chosenY = y
            chosenDistance = gap
          end if
        next y
        lanes(i) = chosenY
      end if
    next i
  end if
  phase = (worldTick \ 6 + selfId * 7) mod 24
  juke = phase \ 3 - 2
  if phase >= 12 then juke = 6 - phase \ 3
  lineY = lanes(me)
  if collector <> me then lineY = lineY + juke
  if teamCount = 1 and collector < 0 then
    lineY = selfY + juke
    if target >= 0 then lineY = py(target) + juke
  end if
  moveTo(holdX, lineY)
end if
if itemRank(4) > 0 and selfLayer = selfTeam then
  wardX = riverEast + 3
  if selfTeam = 1 then wardX = riverWest - 3
  wardY = selfY
  if wardY > 54 and wardY < 74 then wardY = 50
  if (wardX - selfX) * (wardX - selfX) + (wardY - selfY) * (wardY - selfY) <= 1024 then
    placeWard(wardX, wardY)
  elseif busy = 0 then
    wardStage = riverWest - 5
    if selfTeam = 1 then wardStage = riverEast + 5
    moveTo(wardStage, wardY)
  end if
end if

' E06b CurveHook: remember the original perpendicular through windup/flight/return.
if curveEnabled = 0 or selfLayer <> selfTeam or recovering = 1 or attacking = 1 or threat >= 0 or foreignRot = 1 or ownRescue = 1 or worldTick < rescueUntil then
  curveActive = 0
  end
end if
if selfX < curveMinX or selfX > curveMaxX or selfY < 16 or selfY > 111 then
  curveActive = 0
  end
end if
if curveActive = 1 and ownHook < 0 and (curveObserved = 1 or worldTick - curveStarted > 12) then curveActive = 0
if curveActive = 0 and ownHook < 0 and thrown = 1 then
  curveDx = castX - selfX
  curveDy = castY - selfY
  root(curveDx * curveDx + curveDy * curveDy)
  if rootValue > 0 then
    curveVx = 0 - curveDy * 8 \ rootValue
    curveVy = curveDx * 8 \ rootValue
    curveEnd(curveVx, curveVy)
    firstStep = curveStep
    guideX = selfX
    guideY = 64
    if target >= 0 then
      guideX = px(target)
      guideY = py(target)
    end if
    firstDistance = (curveEndX - guideX) * (curveEndX - guideX) + (curveEndY - guideY) * (curveEndY - guideY)
    curveEnd(0 - curveVx, 0 - curveVy)
    secondDistance = (curveEndX - guideX) * (curveEndX - guideX) + (curveEndY - guideY) * (curveEndY - guideY)
    if curveStep > firstStep or (curveStep = firstStep and secondDistance < firstDistance) then
      curveVx = 0 - curveVx
      curveVy = 0 - curveVy
    end if
    curveStarted = worldTick
    curveObserved = 0
    curveActive = 1
  end if
end if
if curveActive = 1 then
  if ownHook >= 0 then curveObserved = 1
  curveEnd(curveVx, curveVy)
  if curveStep = 0 then
    curveVx = 0 - curveVx
    curveVy = 0 - curveVy
    curveEnd(curveVx, curveVy)
  end if
  if curveStep > 0 then
    walkTo(curveEndX, curveEndY)
  else
    curveActive = 0
  end if
end if
