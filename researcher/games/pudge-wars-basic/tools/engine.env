# Pudge Wars Basic: LAST-KNOWN engine, not a pin.
#
# The tools follow the live league (tools/engine.py reads the public Observatory API and
# caches the answer for an hour). These values are used only when that lookup fails, and
# then every tool envelope carries engine.live=false, stale_risk=true and a warning.
# coworld_manifest.json beside this file is the same last-known Coworld's manifest.
GAME_NAME=pudge-wars-basic
LEAGUE_ID=league_84ab9f1e-5fb8-4b62-a3ac-e49026bd12d0
COWORLD_ID=cow_c23845f0-444f-4d2f-864f-5764c58eda4a
COWORLD_VERSION=0.1.8
POLYWORLD_PUDGE_REPO=https://github.com/Metta-AI/polyworld-pudge-wars.git
POLYWORLD_PUDGE_COMMIT=cd8111a5ee4f2fdc38c027615b33421f6c7d2536
SOURCE_URL=https://github.com/Metta-AI/polyworld-pudge-wars/tree/cd8111a5ee4f2fdc38c027615b33421f6c7d2536
# nimby.lock's bassy (the BASIC VM) at the commit above; native.py checks it for that commit.
BASSY_COMMIT=a02e6dd5889310b13d21725c891bde8d01539f08
NIM_VERSION=2.2.10
# The game commit docs/, seed/ and the skills cite. When the live commit differs, every
# envelope's `knowledge.current` is false and says how to renew the knowledge base.
KNOWLEDGE_COMMIT=cd8111a5ee4f2fdc38c027615b33421f6c7d2536
