+class _PromptParts(dict):
+    """The three joined tiers, as ever, plus ``sections``: where each source landed in the prompt."""
+
+    sections: list[dict[str, Any]] = []
+
+
+class _SourcedPart(str):
+    """A prompt part that remembers which source produced it. Still a plain string to everything else."""
+
+
+def _sourced(source: str, parts: list[Optional[str]]) -> list[Optional[str]]:
+    """Label each non-empty part with ``source``; the list keeps its length and text."""
+    labelled: list[Optional[str]] = []
+    for part in parts:
+        if part:
+            part = _SourcedPart(part)
+            part.source = source
+        labelled.append(part)
+    return labelled
+
+
+def _source_sections(tiers: dict[str, list[Optional[str]]]) -> list[dict[str, Any]]:
+    """Where each part lands in the final prompt, following the joins in ``_join_tier`` and
+    ``build_system_prompt``. Text the labels above do not cover is reported as ``hermes``."""
+    sections: list[dict[str, Any]] = []
+    offset = 0
+    for parts in tiers.values():
+        for part in parts:
+            text = part.strip() if part else ""
+            if text:
+                end = offset + len(text)
+                sections.append({"source": getattr(part, "source", "hermes"), "start": offset, "end": end})
+                offset = end + 2  # the "\n\n" joining parts and tiers
+    return sections
+
+
