+def fire_gateway_exit(exit_code: int) -> None:
+    """``on_gateway_exit`` on every profile's manager: a multiplexed gateway keeps one per home, and
+    ``os._exit`` is about to skip every ``atexit`` step. Never discovers plugins this late."""
+    with _plugin_managers_lock:
+        managers = list(dict.fromkeys(_plugin_managers_by_home.values()))
+    for manager in managers:
