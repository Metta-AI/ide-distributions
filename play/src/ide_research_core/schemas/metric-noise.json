{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric noise record (stats/metric-noise.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["game_version", "computed_at", "evidence", "metrics"],
  "properties": {
    "game_version": {"type": "string", "minLength": 1},
    "computed_at": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mean", "marginal_sd", "paired_diff_sd", "n", "n_pairs"],
        "properties": {
          "mean": {"type": "number"},
          "marginal_sd": {"type": "number", "minimum": 0},
          "paired_diff_sd": {"type": ["number", "null"], "minimum": 0},
          "n": {"type": "integer", "minimum": 2},
          "n_pairs": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
