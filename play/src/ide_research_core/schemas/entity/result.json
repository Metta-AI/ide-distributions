{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/entity/result.json",
  "title": "Result: the measured outcome of an experiment's XP (System Design 3.1 #7). Immutable; the body is the analysis write-up.",
  "type": "object",
  "required": [
    "id",
    "experiment",
    "evidence",
    "policy_versions",
    "game_version",
    "episodes_completed",
    "metrics",
    "validity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^R-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "experiment": {
      "type": "string",
      "minLength": 1
    },
    "xp_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_versions": {
      "type": "object",
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "game_version": {
      "type": "string",
      "minLength": 1
    },
    "episodes_completed": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "object"
    },
    "validity": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
