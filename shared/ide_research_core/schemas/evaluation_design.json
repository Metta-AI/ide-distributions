{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen evaluation design (experiment.evaluation_design)",
  "type": "object",
  "additionalProperties": false,
  "required": ["game_version", "baseline_version", "seats", "opponents", "seeds", "metrics", "k", "delta", "n_min", "noise_rev"],
  "properties": {
    "game_version": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "string", "minLength": 1},
    "seats": {"type": "array", "items": {"type": "integer"}},
    "opponents": {"type": "array", "items": {"type": "string"}},
    "seeds": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
    "metrics": {
      "type": "array",
      "contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "primary"}}},
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction", "role", "min_effect", "tolerance"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "direction": {"enum": ["up", "down"]},
          "role": {"enum": ["primary", "agent_guardrail", "performance"]},
          "min_effect": {"type": ["number", "null"]},
          "tolerance": {"type": ["number", "null"]}
        }
      }
    },
    "k": {"type": "number", "exclusiveMinimum": 0},
    "delta": {"type": "object", "additionalProperties": {"type": "number"}},
    "n_min": {"type": "integer", "minimum": 1},
    "noise_rev": {"type": "string", "minLength": 1},
    "lineups": {
      "type": "object",
      "description": "A12: seed (as a string) -> the opponent line-up both arms of that seed face, sampled from the league",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "league_snapshot": {
      "type": "object",
      "description": "A12: the league the lineups were sampled from (stats.opponents.league_snapshot)",
      "required": ["league_id", "taken_at", "basis", "entries"]
    },
    "opponent_rationale": {
      "type": "string",
      "minLength": 1,
      "description": "A12: why the design uses a narrow fixed opponents set instead of sampled lineups"
    }
  }
}
