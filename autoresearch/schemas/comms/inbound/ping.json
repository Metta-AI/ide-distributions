{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/comms/inbound/ping.json",
  "title": "Inbound ping (ar-comms/0): checks the agent is alive.",
  "x-autoresearch": {
    "direction": "inbound",
    "summary": "Checks the agent is alive; acknowledged by the runtime at once.",
