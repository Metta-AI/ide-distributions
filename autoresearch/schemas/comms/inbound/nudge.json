{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comms/inbound/nudge.json",
  "title": "Inbound nudge (ar-comms/0): asks for a quick card that answers it.",
  "x-autoresearch": {
    "direction": "inbound",
    "ack": "card",
    "summary": "Asks for a quick card; that card must answer it.",
    "describe": ["Nudge: {text}"]
  },
  "allOf": [{"$ref": "../envelope.inbound.json"}],
  "required": ["text"],
  "properties": {
    "kind": {"const": "nudge"},
    "text": {"type": "string", "pattern": "\\S", "x-message": "required text"}
  }
}
