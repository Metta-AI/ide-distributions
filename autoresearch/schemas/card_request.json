{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/card_request.json",
  "title": "Card request written by a worker or planner at cards/requests/<Q-id>.json (Overview C3).",
  "type": "object",
  "required": ["id", "op"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^Q-[0-9A-HJKMNP-TV-Z]{26}$"},
    "op": {"enum": ["create", "reprioritize", "drop"]},
    "spec": {
      "type": "object",
      "required": ["request_id", "title", "mode", "why", "refs", "created_by", "priority"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string", "pattern": "^Q-[0-9A-HJKMNP-TV-Z]{26}$"},
        "title": {"type": "string", "minLength": 1},
        "mode": {"enum": ["investigation", "scouting", "experimentation", "maintenance", "planning"]},
        "why": {"type": "string", "minLength": 1},
        "refs": {"type": "array", "items": {"type": "string"}},
        "created_by": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
        "order": {"type": "integer", "minimum": 0, "maximum": 9}
      }
    },
    "target_request": {"type": "string", "pattern": "^Q-[0-9A-HJKMNP-TV-Z]{26}$"},
    "priority": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"op": {"const": "create"}}}, "then": {"required": ["spec"]}},
    {"if": {"properties": {"op": {"const": "reprioritize"}}},
     "then": {"required": ["target_request", "priority"]}},
    {"if": {"properties": {"op": {"const": "drop"}}},
     "then": {"required": ["target_request", "reason"]}}
  ]
}
