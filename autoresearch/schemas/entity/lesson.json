{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/entity/lesson.json",
  "title": "Lesson: how to research, not game facts (System Design 3.1 #12).",
  "type": "object",
  "required": [
    "id",
    "lesson",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^L-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "lesson": {
      "type": "string",
      "minLength": 1
    },
    "scar": {
      "type": "array"
    },
    "recurrences": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "tentative",
        "adopted"
      ]
    }
  },
  "additionalProperties": true
}
