{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/entity/hub.json",
  "title": "Hub: a present-tense synthesis page whose sentences cite claims as [[C-...]] (System Design 3.1 #10). Edited in place.",
  "type": "object",
  "required": [
    "id",
    "title",
    "game_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HUB-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "game_version": {
      "type": [
        "string",
        "integer"
      ]
    },
    "load_when": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
