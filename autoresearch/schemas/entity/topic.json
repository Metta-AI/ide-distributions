{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/entity/topic.json",
  "title": "Topic: a research or development goal with metrics and guardrails (System Design 3.1 #4). Body: free prose.",
  "type": "object",
  "required": [
    "id",
    "title",
    "objective",
    "metrics",
    "guardrails",
    "origin",
    "priority",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "direction"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "up",
              "down"
            ]
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "direction"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "up",
              "down"
            ]
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "inbound": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "priority": {
      "type": [
        "integer",
        "string"
      ]
    },
    "status": {
      "enum": [
        "open",
        "active",
        "achieved",
        "closed"
      ]
    },
    "status_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hubs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strategy_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
